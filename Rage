local function applyTheme()
	local t = themeColors[currentTheme]
	for _, f in ipairs(bgFramesToUpdate) do f.BackgroundColor3 = t.main end
	for _, s in ipairs(uiStrokesToUpdate) do s.Color = t.accent end
	for _, s in ipairs(accentStrokesToUpdate) do s.Color = t.accent end
	for _, b in ipairs(actionButtonsToUpdate) do b.BackgroundColor3 = t.btn end
end

local function makeBox(parent, placeholder, y, text)
	local b = Instance.new("TextBox")
	b.Size = UDim2.new(1, -20, 0, 32)
	b.Position = UDim2.new(0, 10, 0, y)
	b.PlaceholderText = placeholder
	b.Text = text or ""
	b.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.PlaceholderColor3 = Color3.fromRGB(140, 140, 160)
	b.Font = Enum.Font.Gotham
	b.TextSize = 13
	b.ClearTextOnFocus = false
	b.Parent = parent
	corner(b, 6)
	
	table.insert(bgFramesToUpdate, b)
	local stroke = Instance.new("UIStroke")
	stroke.Color = themeColors[currentTheme].accent
	stroke.Thickness = 1.2
	stroke.Parent = b
	table.insert(uiStrokesToUpdate, stroke)
	return b
end

local function makeButton(parent, label, pos, size, color)
