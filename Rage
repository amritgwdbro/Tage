-- ===== CHAT FUNCTION =====
local function getChannel()
	local channels = TextChatService:WaitForChild("TextChannels", 5)
	return channels and channels:FindFirstChild("RBXGeneral")
end

local function sendMessage(msg)
	local channel = getChannel()
	if channel then
		channel:SendAsync(msg)
	else
		pcall(function()
			ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
		end)
	end
end

local function buildMessage(presetIndex, currentType)
	local chosenList = presetsAt
	if currentType == 2 then chosenList = presetsSlash
	elseif currentType == 3 then chosenList = presetsPlus end
	
	local idx = ((presetIndex - 1) % #chosenList) + 1
	local body = chosenList[idx]

	local tName = targetBox.Text ~= "" and targetBox.Text or "PLAYER"
	body = body:gsub("%[TARGET%]", tName)

	return body
end

